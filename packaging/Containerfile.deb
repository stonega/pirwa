FROM docker.io/library/debian:trixie-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential debhelper meson ninja-build pkgconf gettext python3 git \
    appstream desktop-file-utils gsettings-desktop-schemas ca-certificates \
    libglib2.0-dev libgtk-4-dev libadwaita-1-dev libspice-client-glib-2.0-dev \
    libvirt-dev libvirt-glib-1.0-dev libxml2-dev libosinfo-1.0-dev libslirp-dev \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /work
