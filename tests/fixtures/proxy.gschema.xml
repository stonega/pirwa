<?xml version="1.0" encoding="UTF-8"?>
<!-- Isolated schemas for the memory-backend proxy tests. Never installed. -->
<schemalist>
  <schema id="org.gnome.system.proxy" path="/system/proxy/">
    <key name="mode" type="s"><default>'none'</default></key>
    <key name="ignore-hosts" type="as"><default>['localhost', '127.0.0.0/8']</default></key>
  </schema>
  <schema id="org.gnome.system.proxy.socks" path="/system/proxy/socks/">
    <key name="host" type="s"><default>''</default></key>
    <key name="port" type="i"><default>0</default></key>
  </schema>
  <schema id="org.gnome.system.proxy.http" path="/system/proxy/http/">
    <key name="host" type="s"><default>''</default></key>
    <key name="port" type="i"><default>0</default></key>
    <key name="use-authentication" type="b"><default>false</default></key>
    <key name="authentication-user" type="s"><default>''</default></key>
    <key name="authentication-password" type="s"><default>''</default></key>
  </schema>
  <schema id="org.gnome.system.proxy.https" path="/system/proxy/https/">
    <key name="host" type="s"><default>''</default></key>
    <key name="port" type="i"><default>0</default></key>
  </schema>
</schemalist>
